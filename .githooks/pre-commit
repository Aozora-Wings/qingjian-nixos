#!/usr/bin/env bash
# 瘦身后本地仓库不维护官方 crates（flake input 提供，构建时合并），
# cargo fmt/clippy 等全 workspace 检查由 GitHub Actions（check-upstream.yml）负责。
# 此处只保留轻量的仓库卫生检查；需要本地完整验证时用 `nix build .#qingjianServer`。
# 启用：git config core.hooksPath .githooks；跳过：git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 装饰性分隔注释（`// ====` / `// ────`）不要：只做视觉分组、不带任何「为什么」，用空行加语义排序分组
staged_rs="$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')"
if [[ -n "$staged_rs" ]]; then
  matches="$(echo "$staged_rs" | xargs grep -nE '^\s*//[/!]?\s*[=─-]{3,}\s*$' 2>/dev/null || true)"
  if [[ -n "$matches" ]]; then
    echo "$matches"
    echo "装饰性分隔注释不要，用空行 + 语义排序分组" >&2
    exit 1
  fi
fi
