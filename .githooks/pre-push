#!/usr/bin/env bash
# 推之前跑全 workspace 测试（提交时不跑，太慢）；跳过：git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Linux 移植：macOS 专用 crate（qingjian-macos，依赖 objc2）在 Linux 上无法编译，
# 与 pre-commit 的 clippy 保持一致排除；macOS/Windows 上保持原样。
if [[ "$(uname)" == "Linux" ]]; then
  cargo test --workspace --locked --exclude qingjian-macos
else
  cargo test --workspace --locked
fi
